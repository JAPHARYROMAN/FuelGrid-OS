# Build context hygiene — keep the layer that COPY's into the builder small.

.git
.github
.husky
.vscode
.idea
.DS_Store
Thumbs.db

node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
coverage
**/coverage
dist
**/dist
build
**/build
bin
**/bin

# The API build (services/api/Dockerfile) does not need apps/, but the web
# build (apps/web/Dockerfile) does — both use the repo root as context. Ignore
# everything under apps/ EXCEPT the web app source the web image compiles.
# (node_modules/.next/coverage are already pruned by the **/ rules above.)
apps/*
!apps/web
# Re-apply generated-directory exclusions after the negation above. Docker's
# last matching rule wins, so without these a local web build can resend the
# entire pnpm tree and .next output (hundreds of MB) as build context.
apps/web/node_modules
apps/web/.next
apps/web/coverage
apps/web/playwright-report
apps/web/test-results
docs
.env
.env.*
!.env.example
*.log
*.md
